                    </div>
                </div>
            </form>
            <div class="alert alert-success small mt-2 mb-0 apercu" hidden></div>
        </div>

        <div class="ligne py-2 border-top">
            <div class="row g-2 align-items-center">
                <label class="col-sm-3 col-form-label" for="selBat">Bâtiment</label>
                <div class="col-sm-6"><select id="selBat" class="form-select" data-vide="Choisir un bâtiment" data-aucun="Aucun bâtiment pour cette rue" data-attendu="une rue"></select></div>
                <div class="col-sm-3 d-flex gap-1"><button type="button" class="btn btn-outline-mh btn-sm" data-ouvre="formBat">Ajouter</button><button type="button" class="btn btn-outline-danger btn-sm" data-supprime="selBat" data-cat="Batiment" disabled>Supprimer</button></div>
            </div>
            <form id="formBat" class="form-ajout bg-light border rounded p-3 mt-2" data-entite="bâtiment" data-article="un" data-nom-entite="Batiment"
                  data-parents='[{"champ":"NumCite","select":"selCite","nom":"cité"},{"champ":"CodeRue","select":"selRue","nom":"rue"}]' hidden>
                <div class="fw-semibold mb-2 titre-ajout"></div>
                <div class="row g-2 align-items-end">
