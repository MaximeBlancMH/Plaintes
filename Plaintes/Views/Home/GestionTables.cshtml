@* Page « Gestion des tables ».
   Deux blocs : Lieux (Cité -> Rue -> Bâtiment, et Partie commune) et Types (Catégorie -> Sous-catégorie -> Nuisance).
   Une ligne par liste déroulante, avec un bouton « Ajouter » qui ouvre, sous la ligne, le formulaire d'ajout d'un élément rattaché à la
   sélection du parent. Une liste reste grisée tant que son parent n'est pas choisi.
   Pour l'instant, seul l'affichage existe : valider un formulaire montre un aperçu de ce qui serait créé (avec son parent), sans rien enregistrer. *@
@model GestionTablesViewModel
@{
    ViewData["Title"] = "Gestion des tables";

    // Un lien « cité -> rue » existe soit dans cite_rue, soit parce qu'un bâtiment de la cité a une adresse dans cette rue.
    var batimentParId = Model.Batiments.ToDictionary(b => b.IdBat);
    var liensCiteRue = Model.CiteRues.Select(cr => new { cite = cr.NumCite, rue = cr.CodeRue })
        .Concat(Model.BatimentRues.Where(br => batimentParId.ContainsKey(br.IdBat))
            .Select(br => new { cite = batimentParId[br.IdBat].NumCite, rue = br.CodeRue }))
        .Distinct()
        .ToList();

    var donnees = new
    {
        cites = Model.Cites.OrderBy(c => c.LibCite).Select(c => new { id = c.NumCite, lib = c.LibCite, secteur = c.Secteur }),
        rues = Model.Rues.OrderBy(r => r.LibRue).Select(r => new { id = r.CodeRue, lib = r.LibRue, cp = r.Cp, ville = r.Ville }),
        citeRues = liensCiteRue,
        batiments = Model.Batiments.OrderBy(b => b.NumBat).Select(b => new { id = b.IdBat, cite = b.NumCite, num = b.NumBat, lib = b.LibBat, tranche = b.CodeTranche }),
        batimentRues = Model.BatimentRues.Select(br => new { bat = br.IdBat, rue = br.CodeRue, num = br.NumRue }),
        partiesCommunes = Model.PartieCommunes.Where(p => !p.SupprPc).OrderBy(p => p.LibPartieCommune).Select(p => new { code = p.CodePartieCommune, lib = p.LibPartieCommune }),
        categories = Model.Categories.Where(c => !c.SupprCat).OrderBy(c => c.LibCat).Select(c => new { code = c.CodeCat, lib = c.LibCat }),
        sousCategories = Model.SousCategories.Where(s => !s.SupprSousCat).OrderBy(s => s.LibSousCat).Select(s => new { code = s.CodeSousCat, cat = s.CodeCat, lib = s.LibSousCat }),
        nuisances = Model.Nuisances.Where(n => !n.SupprNuisance).OrderBy(n => n.LibNuisance).Select(n => new { code = n.CodeNuisance, sousCat = n.CodeSousCat, lib = n.LibNuisance })
    };

    // Zone de test TEMPORAIRE (Development uniquement) : voir Views/Shared/_ZoneTest.cshtml. Les cas sont joués par le script de la page.
    var casTables = new List<CasTest>
    {
        new("Sélection par parent", "Parcours Cité → Rue → Bâtiment", "Les trois listes se remplissent l'une après l'autre", Script: "parcoursLieux"),
        new("Sélection par parent", "Cité sans aucune rue", "La liste des rues indique « Aucune rue » et le bâtiment reste grisé", Script: "citeSansRue"),
        new("Sélection par parent", "Changer de cité après avoir choisi une rue", "La rue et le bâtiment sont remis à zéro", Script: "changerCite"),
        new("Sélection par parent", "Parcours Catégorie → Sous-catégorie → Nuisance", "Les trois listes se remplissent l'une après l'autre", Script: "parcoursTypes"),
        new("Sélection par parent", "Catégorie sans sous-catégorie", "La liste des sous-catégories indique « Aucune sous-catégorie »", Script: "catSansSousCat"),
        new("Sélection par parent", "Tout remettre à zéro", "Toutes les listes reviennent à « Choisir »", Script: "toutVider"),
        new("Formulaires d'ajout (aperçu seulement)", "Rue : formulaire vide", "Le navigateur signale le champ obligatoire", Script: "rueVide"),
        new("Formulaires d'ajout (aperçu seulement)", "Cité : secteur « Autre »", "Le champ de saisie apparaît ; aperçu avec le secteur en majuscules", Script: "citeAutre"),
        new("Formulaires d'ajout (aperçu seulement)", "Rue valide (rattachée à la cité)", "Aperçu avec NumCite du parent", Script: "rueValide"),
        new("Formulaires d'ajout (aperçu seulement)", "Bâtiment valide (cité + rue)", "Aperçu avec NumCite et CodeRue du parent", Script: "batValide"),
        new("Formulaires d'ajout (aperçu seulement)", "Nuisance valide (sous-catégorie)", "Aperçu avec CodeSousCat du parent", Script: "nuisanceValide"),
        new("Ajout (enregistre vraiment si valide)", "Cité : champs vides", "Erreur : « Libellé » est obligatoire", "~/Home/addElement", "POST", new[] { ("cat", "Cite") }),
        new("Ajout (enregistre vraiment si valide)", "Rue : cité inexistante", "Erreur : la cité choisie n'existe pas", "~/Home/addElement", "POST", new[] { ("cat", "Rue"), ("LibRue", "Rue de test"), ("Cp", "71000"), ("Ville", "Mâcon"), ("NumCite", "0") }),
        new("Ajout (enregistre vraiment si valide)", "Catégorie : code déjà utilisé", "Erreur : ce code existe déjà (« Code obligatoire » s'il n'y a aucune catégorie)", "~/Home/addElement", "POST", new[] { ("cat", "Categorie"), ("CodeCat", Model.Categories.FirstOrDefault()?.CodeCat ?? ""), ("LibCat", "Doublon") }),
        new("Ajout (enregistre vraiment si valide)", "Type d'élément inconnu", "Erreur : type d'élément inconnu", "~/Home/addElement", "POST", new[] { ("cat", "Truc") }),
        new("Suppression", "Cité inconnue (id 0)", "Erreur : élément introuvable", "~/Home/deleteElement", "POST", new[] { ("cat", "Cite"), ("code", "0") }),
        new("Suppression", "Identifiant invalide (abc)", "Erreur : identifiant invalide", "~/Home/deleteElement", "POST", new[] { ("cat", "Rue"), ("code", "abc") }),
        new("Suppression", "Type d'élément inconnu", "Erreur : type d'élément inconnu", "~/Home/deleteElement", "POST", new[] { ("cat", "Truc"), ("code", "1") }),
    };
}

<h1 class="h3 my-4 titre-mh">Gestion des tables</h1>

@* Message affiché par le script après une suppression (sans rechargement de la page). *@
<div id="zoneMessages"></div>

@* Résultat de la dernière action (ajout ou suppression), laissé par le contrôleur avant la redirection. *@
@if (TempData["Erreur"] is string erreur && !string.IsNullOrWhiteSpace(erreur))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @erreur
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}
@if (TempData["Succes"] is string succes && !string.IsNullOrWhiteSpace(succes))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @succes
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}

@* ======================== Lieux ======================== *@
<section class="card shadow-sm card-mh mb-4 groupe">
    <div class="card-header h5 mb-0">Lieux</div>
    <div class="card-body">

        <div class="ligne py-2">
            <div class="row g-2 align-items-center">
                <label class="col-sm-3 col-form-label" for="selCite">Cité</label>
                <div class="col-sm-6"><select id="selCite" class="form-select" data-vide="Choisir une cité" data-aucun="Aucune cité"></select></div>
                <div class="col-sm-3 d-flex gap-1"><button type="button" class="btn btn-outline-mh btn-sm" data-ouvre="formCite">Ajouter</button><button type="button" class="btn btn-outline-danger btn-sm" data-supprime="selCite" data-cat="Cite" disabled>Supprimer</button></div>
            </div>
            <form id="formCite" class="form-ajout bg-light border rounded p-3 mt-2" data-entite="cité" data-nom-entite="Cite" hidden>
                <div class="fw-semibold mb-2 titre-ajout"></div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small mb-1">Libellé</label>
                        <input name="LibCite" class="form-control form-control-sm" maxlength="100" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-1" for="secteurChoix">Secteur</label>
                        <select id="secteurChoix" class="form-select form-select-sm" required>
                            <option value="">— Choisir —</option>
                            <option value="CENTRE">CENTRE</option>
                            <option value="SUD">SUD</option>
                            <option value="AUTRE">Autre…</option>
                        </select>
                        @* Si « Autre » : le secteur est saisi ici. Le champ caché Secteur porte la valeur finale. *@
                        <input id="secteurAutre" class="form-control form-control-sm mt-2 text-uppercase" maxlength="10" placeholder="Précisez le secteur" hidden />
                        <input type="hidden" name="Secteur" id="secteurFinal" />
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-mh btn-sm">Valider</button>
                        <button type="button" class="btn btn-link btn-sm text-decoration-none" data-annule="formCite">Annuler</button>
                    </div>
                </div>
            </form>
            <div class="alert alert-success small mt-2 mb-0 apercu" hidden></div>
        </div>

        <div class="ligne py-2 border-top">
            <div class="row g-2 align-items-center">
                <label class="col-sm-3 col-form-label" for="selRue">Rue</label>
                <div class="col-sm-6"><select id="selRue" class="form-select" data-vide="Choisir une rue" data-aucun="Aucune rue pour cette cité" data-attendu="une cité"></select></div>
                <div class="col-sm-3 d-flex gap-1"><button type="button" class="btn btn-outline-mh btn-sm" data-ouvre="formRue">Ajouter</button><button type="button" class="btn btn-outline-danger btn-sm" data-supprime="selRue" data-cat="Rue" disabled>Supprimer</button></div>
            </div>
            <form id="formRue" class="form-ajout bg-light border rounded p-3 mt-2" data-entite="rue" data-nom-entite="Rue"
                  data-parents='[{"champ":"NumCite","select":"selCite","nom":"cité"}]' hidden>
                <div class="fw-semibold mb-2 titre-ajout"></div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small mb-1">Libellé</label>
                        <input name="LibRue" class="form-control form-control-sm" maxlength="150" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Code postal</label>
                        <input name="Cp" class="form-control form-control-sm" maxlength="50" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Ville</label>
