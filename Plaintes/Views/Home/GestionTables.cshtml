                        <input name="NumBat" class="form-control form-control-sm" maxlength="11" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">N° dans la rue</label>
                        <input name="NumRue" class="form-control form-control-sm" maxlength="50" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-1">Libellé <span class="text-muted">(facultatif)</span></label>
                        <input name="LibBat" class="form-control form-control-sm" maxlength="50" />
                    </div>
