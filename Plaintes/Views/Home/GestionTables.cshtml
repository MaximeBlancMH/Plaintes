                <div class="fw-semibold mb-2 titre-ajout"></div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Code</label>
                        <input name="CodePartieCommune" class="form-control form-control-sm text-uppercase" maxlength="4" required />
                    </div>
                    <div class="col-md-7">
                        <label class="form-label small mb-1">Libellé</label>
                        <input name="LibPartieCommune" class="form-control form-control-sm" maxlength="50" required />
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-mh btn-sm">Valider</button>
                        <button type="button" class="btn btn-link btn-sm text-decoration-none" data-annule="formPc">Annuler</button>
                    </div>
                </div>
            </form>
            <div class="alert alert-success small mt-2 mb-0 apercu" hidden></div>
        </div>
    </div>
</section>

