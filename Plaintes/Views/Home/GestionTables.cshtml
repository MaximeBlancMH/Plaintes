                        <label class="form-label small mb-1">Tranche</label>
                        <input name="CodeTranche" class="form-control form-control-sm" maxlength="5" />
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-mh btn-sm">Valider</button>
                        <button type="button" class="btn btn-link btn-sm text-decoration-none" data-annule="formBat">Annuler</button>
                    </div>
                </div>
            </form>
            <div class="alert alert-success small mt-2 mb-0 apercu" hidden></div>
        </div>

        <div class="ligne py-2 border-top">
            <div class="row g-2 align-items-center">
                <label class="col-sm-3 col-form-label" for="selPc">Partie commune</label>
                <div class="col-sm-6"><select id="selPc" class="form-select" data-vide="Choisir une partie commune" data-aucun="Aucune partie commune"></select></div>
                <div class="col-sm-3 d-flex gap-1"><button type="button" class="btn btn-outline-mh btn-sm" data-ouvre="formPc">Ajouter</button><button type="button" class="btn btn-outline-danger btn-sm" data-supprime="selPc" data-cat="PartieCommune" disabled>Supprimer</button></div>
            </div>
