<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Plaintes</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Plaintes.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @{
            var isAuth = (User.Identity?.IsAuthenticated ?? false) && !Plaintes.Services.ComptesClaims.EstRefuse(User);   // un compte refusé ne voit ni menu ni nom
            var chemin = Context.Request.Path.Value ?? "";
            var compteNom = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
            var compteEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
            var compteDroit = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            // Un lien du menu n'est affiché que si l'utilisateur a le droit d'ouvrir la page (mêmes rôles que les actions des contrôleurs)
            var peutSaisir = User.IsInRole("W") || User.IsInRole("A") || User.IsInRole("S");
            var peutGererUtilisateurs = User.IsInRole("A") || User.IsInRole("S");
            var peutGererTables = User.IsInRole("S");
            // Renvoie " active" si l'adresse de la page commence par celle du lien (sauf pour l'adresse à exclure)
            string Active(string lien, string? exclure = null) =>
                chemin.StartsWith(lien, StringComparison.OrdinalIgnoreCase)
                && (exclure is null || !chemin.StartsWith(exclure, StringComparison.OrdinalIgnoreCase)) ? " active" : "";
        }
        @* Barre de navigation *@
        <nav class="navbar navbar-expand-lg navbar-mh sticky-top" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/Logo-MHabitat-2022.png" alt="Mâcon Habitat" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain"
                        aria-controls="navMain" aria-expanded="false" aria-label="Afficher le menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMain">
                    @* Le menu n'est visible que si l'utilisateur est connecté *@
                    @if (isAuth)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link@(Active("/Dossiers", "/Dossiers/Creer"))" href="/Dossiers">Dossiers</a>
                            </li>
                            @if (peutSaisir)
                            {
                                <li class="nav-item">
                                    <a class="nav-link@(Active("/Dossiers/Creer"))" href="/Dossiers/Creer">Saisir un dossier</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link@(Active("/Statistiques"))" href="/Statistiques">Statistiques</a>
                            </li>
                            @if (peutGererUtilisateurs)
                            {
                                <li class="nav-item">
                                    <a class="nav-link@(Active("/Account/AllAccounts"))" href="/Account/AllAccounts">Gestion Utilisateurs</a>
                                </li>
                            }
                            @if (peutGererTables)
                            {
                                <li class="nav-item">
                                    <a class="nav-link@(Active("/GestionTables"))" href="/GestionTables">Gestion des tables</a>
                                </li>
                            }
                        </ul>
                        @* Nom de l'utilisateur (infos au survol) et bouton de déconnexion *@
                        <div class="navbar-user d-flex align-items-lg-center flex-column flex-lg-row gap-2 gap-lg-3 pt-2 pt-lg-0">
                            <div class="compte-hover" tabindex="0">
                                <span class="navbar-text text-white fw-semibold">@User.Identity!.Name</span>
                                <div class="compte-hover-card card-mh shadow" role="tooltip">
                                    <div class="compte-ligne"><strong>Nom</strong><span>@(string.IsNullOrWhiteSpace(compteNom) ? "—" : compteNom)</span></div>
                                    <div class="compte-ligne"><strong>Email</strong><span>@(string.IsNullOrWhiteSpace(compteEmail) ? "—" : compteEmail)</span></div>
                                    <div class="compte-ligne"><strong>Droits</strong><span>@CompteViewModel.LibelleDroit(compteDroit)</span></div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-mh btn-sm" data-bs-toggle="modal" data-bs-target="#logoutModal">
                                Déconnexion
                            </button>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    @* Fenêtre de confirmation de déconnexion *@
    @if (isAuth)
    {
        <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header modal-header-mh">
                        <h5 class="modal-title" id="logoutModalLabel">Déconnexion</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2"><strong>Attention :</strong> cette action vous déconnecte également de votre compte Microsoft.</p>
                        <p class="mb-0 text-muted">Vous devrez vous authentifier de nouveau pour accéder à l'application.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-mh">Se déconnecter</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    @* Une page peut élargir son conteneur avec ViewData["ClasseConteneur"] (ex. la page Dossiers) *@
    <div class="@(ViewData["ClasseConteneur"] as string ?? "container")">
        <main role="main" class="pb-3">
            @* Contenu de la page *@
            @RenderBody()
        </main>
    </div>

    <footer class="footer-mh">
        &copy; @DateTime.Now.Year - <span class="fw-semibold">Mâcon Habitat</span> - Plaintes
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Scripts propres à chaque page *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
