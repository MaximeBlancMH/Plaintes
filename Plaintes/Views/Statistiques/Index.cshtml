@* Page « Statistiques » : filtres croisés et graphiques cliquables.
   Le serveur envoie les chiffres de départ ; quand on change un filtre (ou qu'on clique sur un graphique), js/statistiques.js
   redemande les chiffres à /Statistiques/Donnees et redessine tout, sans recharger la page. L'adresse garde les filtres choisis. *@
@model StatistiquesPageViewModel
@{
    ViewData["Title"] = "Statistiques";
}

@* Titre et réinitialisation *@
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 my-4">
    <h1 class="h3 mb-0 titre-mh">Statistiques</h1>
    <div class="d-flex gap-2">
        @* Export Excel : le script met à jour l'adresse du lien à chaque changement de filtre *@
        <a class="btn btn-sm btn-outline-mh" id="statExport" data-url="@Url.Action("ExportExcel", "Statistiques")"
           href="@Url.Action("ExportExcel", "Statistiques")@Context.Request.QueryString" title="Télécharge en Excel les statistiques avec ces filtres">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3v12M7 10l5 5 5-5M5 21h14" />
            </svg>
            Exporter en Excel
        </a>
        <button type="button" class="btn btn-sm btn-outline-mh" id="statReinitialiser">Réinitialiser les filtres</button>
    </div>
</div>

<div id="statistiques" data-url="@Url.Content("~/Statistiques/Donnees")">

    @* Filtres : chaque liste dépend de la précédente (secteur -> cité, catégorie -> sous-catégorie -> nuisance) *@
    <div class="card shadow-sm card-mh mb-3 stat-filtres">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-6 col-md-3"><label for="fSecteur" class="form-label">Secteur</label><select id="fSecteur" class="form-select form-select-sm" data-cle="secteur"></select></div>
                <div class="col-6 col-md-3"><label for="fCite" class="form-label">Cité</label><select id="fCite" class="form-select form-select-sm" data-cle="cite"></select></div>
                <div class="col-6 col-md-3"><label for="fPartieCommune" class="form-label">Partie commune</label><select id="fPartieCommune" class="form-select form-select-sm" data-cle="partieCommune"></select></div>
                <div class="col-6 col-md-3"><label for="fCategorie" class="form-label">Catégorie</label><select id="fCategorie" class="form-select form-select-sm" data-cle="categorie"></select></div>
                <div class="col-6 col-md-3"><label for="fSousCategorie" class="form-label">Sous-catégorie</label><select id="fSousCategorie" class="form-select form-select-sm" data-cle="sousCategorie"></select></div>
                <div class="col-6 col-md-3"><label for="fNuisance" class="form-label">Nuisance</label><select id="fNuisance" class="form-select form-select-sm" data-cle="nuisance"></select></div>
            </div>
            @* Période (date de début des faits) : deux poignées, mois par mois, entre le premier et le dernier mois des dossiers
               qui répondent aux autres filtres. Les bornes se resserrent quand les autres filtres réduisent la période couverte. *@
            <div class="mt-3" id="blocPeriode">
                <div class="d-flex justify-content-between align-items-baseline">
                    <span class="form-label mb-1">Période <span class="text-muted">(début des faits)</span></span>
                    <span class="small fw-semibold" id="periodeTexte"></span>
                </div>
                <div class="range-double">
                    <div class="piste"></div>
                    <div class="piste-active" id="periodePiste"></div>
                    <input type="range" id="periodeDebut" min="0" max="0" step="1" value="0" aria-label="Premier mois de la période" />
                    <input type="range" id="periodeFin" min="0" max="0" step="1" value="0" aria-label="Dernier mois de la période" />
                </div>
                <div class="d-flex justify-content-between text-muted small"><span id="periodeMin"></span><span id="periodeMax"></span></div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3" id="filtresActifs"></div>
        </div>
    </div>

    @* Message quand aucun dossier ne correspond aux filtres *@
    <div class="card shadow-sm card-mh mb-4" id="statVide" hidden>
        <div class="card-body text-center text-muted py-5">Aucun dossier ne correspond à ces filtres.</div>
    </div>
    <div class="alert alert-danger" id="statErreur" hidden></div>

    <div id="statContenu">
        @* Chiffres clés *@
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3"><div class="card shadow-sm stat-carte h-100"><div class="card-body">
                <div class="stat-chiffre" id="kpiTotal"></div><div class="stat-libelle" id="kpiTotalLibelle">Dossiers</div>
            </div></div></div>
            <div class="col-6 col-lg-3"><div class="card shadow-sm stat-carte h-100"><div class="card-body">
                <div class="stat-chiffre" id="kpiCout"></div><div class="stat-libelle">Coût total</div>
            </div></div></div>
            <div class="col-6 col-lg-3"><div class="card shadow-sm stat-carte h-100"><div class="card-body">
                <div class="stat-chiffre" id="kpiCoutMoyen"></div><div class="stat-libelle">Coût moyen par dossier</div>
            </div></div></div>
            <div class="col-6 col-lg-3"><div class="card shadow-sm stat-carte h-100"><div class="card-body">
                <div class="stat-chiffre" id="kpiDetails"></div><div class="stat-libelle">Nuisances signalées</div>
            </div></div></div>
        </div>

        @* Évolution : dossiers ou coûts, comparés à l'année précédente quand une année est choisie *@
        <div class="card shadow-sm card-mh mb-4">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="h6 mb-0" id="titreEvolution">Évolution</span>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <div class="stat-legende-courbe" id="legendeEvolution"></div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Valeur affichée">
                        <button type="button" class="btn btn-outline-mh active" data-mode="dossiers">Dossiers</button>
                        <button type="button" class="btn btn-outline-mh" data-mode="cout">Coût</button>
                    </div>
                </div>
            </div>
            <div class="card-body"><div id="grapheEvolution"></div></div>
        </div>

        @* Répartitions et classements : les cartes sont créées par le script, dans une grille qui se réorganise selon la largeur de l'écran.
           Un graphique que les filtres rendent sans intérêt (ex. les cités quand une cité est choisie) est remplacé par une autre statistique. *@
        <div class="stat-cartes mb-4" id="statCartes"></div>
    </div>
</div>

@* Info-bulle partagée par tous les graphiques *@
<div id="statBulle" class="stat-bulle" role="tooltip"></div>

@* Données de départ lues par le script : filtres, chiffres, valeurs des listes *@
<script type="application/json" id="donneesStats">@Html.Raw(Json.Serialize(new { filtres = Model.Filtres, resultat = Model.Resultat, options = Model.Options }))</script>

@section Scripts {
    <script src="~/js/statistiques.js" asp-append-version="true"></script>
}
