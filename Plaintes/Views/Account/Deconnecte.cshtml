@{
    ViewData["Title"] = "Déconnexion";
}

@* Message de confirmation de déconnexion *@
<div class="row justify-content-center my-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm text-center logout-card">
            <div class="card-body p-4 p-md-5">
                <div class="logout-icon mb-3" aria-hidden="true">&#10003;</div>
                <h1 class="h3 mb-3">Vous êtes déconnecté</h1>
                <p class="text-muted mb-4">
                    Votre session a bien été fermée. Pour accéder de nouveau à l'application,
                    reconnectez-vous avec votre compte Microsoft.
                </p>
                <a class="btn btn-mh btn-lg" asp-controller="Account" asp-action="Login">Se reconnecter</a>
            </div>
        </div>
    </div>
</div>
