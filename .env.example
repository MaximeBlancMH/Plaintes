# Copier en .env (non versionné) et renseigner les valeurs.
VERSION=1.0.0

# Base SQL Server
DB_SERVEUR=sql.macon-habitat.local
DB_NOM=PLAINTES
DB_UTILISATEUR=plaintes_app
DB_MOT_DE_PASSE=

# Adresse publique de l'application (sans https://) : elle devient l'Entity ID SAML (https://<hôte>/saml2),
# qui doit être déclaré à l'identique dans Entra ID. Essai en local : localhost:3001
HOTE_PUBLIC=plaintes.macon-habitat.com

# Microsoft Entra ID (SAML)
SAML_IDP_ENTITY_ID=https://sts.windows.net/<tenant>/
SAML_METADATA_URL=https://login.microsoftonline.com/<tenant>/federationmetadata/2007-06/federationmetadata.xml?appid=<appid>
